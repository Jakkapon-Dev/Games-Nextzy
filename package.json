{
  "name": "games-nextzy",
  "private": true,
  "description": "Nextzy points game: Next.js web app and NestJS API in one repository",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write apps .github package.json .prettierrc.json README.md --ignore-unknown --no-error-on-unmatched-pattern",
    "format:check": "prettier --check apps .github package.json .prettierrc.json README.md --ignore-unknown --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
