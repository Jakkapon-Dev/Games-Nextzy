// Prisma schema for the Nextzy points game API.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Anonymous player identified by a browser session.
model Player {
  id              String          @id @default(uuid()) @db.Uuid
  /// 0..10000, enforced by a CHECK constraint in the migration.
  totalScore      Int             @default(0) @map("total_score")
  /// Starts at 1 and increments only when progress is reset.
  progressVersion Int             @default(1) @map("progress_version")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions        PlayerSession[]
  rounds          GameRound[]

  @@map("players")
}

/// Browser session. Only the SHA-256 hash of the cookie token is stored.
model PlayerSession {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @map("player_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("player_sessions")
}

/// Reward checkpoint. Rows are inserted by the migration that creates the table.
model Checkpoint {
  id            String @id
  requiredScore Int    @unique @map("required_score")
  rewardName    String @map("reward_name")

  @@map("checkpoints")
}

/// One play of the game. `requestId` makes retries idempotent within a progress version.
model GameRound {
  id              String   @id @default(uuid()) @db.Uuid
  playerId        String   @map("player_id") @db.Uuid
  requestId       String   @map("request_id") @db.Uuid
  progressVersion Int      @map("progress_version")
  /// 300, 500, 1000 or 3000.
  pickedScore     Int      @map("picked_score")
  /// Points actually added after applying the 10,000 cap.
  creditedScore   Int      @map("credited_score")
  totalScoreAfter Int      @map("total_score_after")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, progressVersion, requestId])
  @@index([playerId, progressVersion, createdAt(sort: Desc)])
  @@map("game_rounds")
}
